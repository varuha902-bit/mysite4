{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-event-genius/event-cta",
	"title": "Event CTA",
	"category": "event-genius",
	"description": "Displays event cost, remaining spots, and registration button.",
	"textdomain": "event-genius",
	"editorScript": "file:./build/index.js",
	"editorStyle": [ "evge_common", "evge_single_post" ],
	"style": [ "evge_common", "evge_single_post" ],
	"render": "file:./render.php",
	"attributes": {
		"eventId": {
			"type": "number",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
